# ---- Secrets: never commit ----
# Release signing keystore + its plaintext password. Losing these means you can
# never ship an update that installs over an existing copy of the app.
keys/
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
secrets.json
*.local.json

