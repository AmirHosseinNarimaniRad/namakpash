<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- sqlite-net's browser-wasm e_sqlite3 is only linked when the wasm-tools workload relinks
         natively. Without this the app throws DllNotFoundException on the first query — the
         build only warns. See Splitt.Wasm.Spike/README.md. -->
    <WasmBuildNative>true</WasmBuildNative>

    <!-- The app is served from https://namakpash.namakco.ir/app/, a subfolder, so every asset
         path has to resolve relative to it. -->
    <StaticWebAssetBasePath>app</StaticWebAssetBasePath>

    <!-- Generates service-worker-assets.js (every published asset, with integrity hashes) and
         swaps service-worker.published.js in for service-worker.js. Without this the app cannot
         start with no network, which is the whole promise. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Splitt.Core\Splitt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The property above is not enough on its own: this item is what makes publish replace the
         development no-op worker with the offline one and emit the assets manifest. -->
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
