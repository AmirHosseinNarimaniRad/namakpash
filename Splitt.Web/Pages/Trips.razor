@page "/"
@inject Store Store
@inject NavigationManager Nav

<PageTitle>نمک‌پاش</PageTitle>

<header class="appbar">
    <h1>نمک‌پاش</h1>
    <button class="action" @onclick="RestoreAsync">بازیابی</button>
</header>

<main class="page has-fab">
    @if (loading)
    {
        <p class="caption">در حال خواندن…</p>
    }
    else if (cards.Count == 0)
    {
        <div class="empty">
            <div class="emoji">🧂</div>
            <p class="section-label">هنوز رویدادی نساخته‌ای</p>
            <p class="caption">اولین رویداد را بساز — سفر، دورهمی، مهمانی یا رستوران. هزینه‌ها را راحت دنگ کن.</p>
        </div>
    }
    else
    {
        <div class="stack" style="gap:12px">
            @foreach (var card in cards)
            {
                <button class="card" @onclick="() => Open(card.Id)">
                    <div class="row">
                        <div>
                            <p class="section-label">@card.Name</p>
                            <p class="caption">@card.SubText</p>
                        </div>
                        <span class="amount" style="color:var(--primary)">@card.TotalText</span>
                    </div>
                </button>
            }
        </div>
    }

    @if (restored is not null)
    {
        <div class="notice" role="status" @onclick="() => restored = null">
            <strong>بازیابی شد.</strong> @restored
        </div>
    }

    @if (restoreError is not null)
    {
        <div class="notice">
            <strong>@restoreError</strong> چیزی وارد نشد و اطلاعات فعلی دست‌نخورده ماند.
        </div>
    }

    @if (Store.LoadError is not null)
    {
        <div class="notice">
            <strong>اطلاعات خوانده نشد.</strong> برای اینکه چیزی از بین نرود، نمک‌پاش روی آن چیزی ننوشت.
            اگر فایل پشتیبان داری، «بازیابی» را بزن. @Store.LoadError
        </div>
    }
</main>

<button class="fab" @onclick='() => Nav.NavigateTo("trip-editor")'>＋ رویداد جدید</button>

@code {
    record Card(int Id, string Name, string SubText, string TotalText);

    List<Card> cards = [];
    bool loading = true;
    string? restoreError;
    string? restored;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    void Open(int id) => Nav.NavigateTo($"trip/{id}");

    async Task LoadAsync()
    {
        loading = true;
        var built = new List<Card>();

        foreach (var trip in await Store.Db.GetTripsAsync())
        {
            var people = await Store.Db.GetParticipantsAsync(trip.Id);
            var expenses = await Store.Db.GetExpensesAsync(trip.Id);
            var real = expenses.Where(e => !e.IsSettlement).ToList();

            built.Add(new Card(
                trip.Id,
                trip.Name,
                $"{people.Count} نفر · {real.Count} هزینه",
                MoneyFormat.FormatToman(real.Sum(e => e.Amount))));
        }

        cards = built;
        loading = false;
    }

    async Task RestoreAsync()
    {
        restoreError = null;
        restored = null;
        var json = await Store.PickTextFileAsync();
        if (string.IsNullOrWhiteSpace(json)) return;

        try
        {
            var dto = TripExporter.FromJson(json);
            var trip = await Store.MutateAsync(db => db.ImportTripAsync(dto));

            // Stay on the list and say so, the way the Android app does. The imported event
            // is right there in the list; jumping into it silently reads like nothing happened.
            await LoadAsync();
            restored = $"رویداد «{trip.Name}» با موفقیت وارد شد.";
        }
        catch (Exception)
        {
            // One fixed sentence: a malformed file throws before Core's own Persian validation
            // ever runs, and System.Text.Json's English message would land in the UI.
            restoreError = "فایل انتخاب‌شده یک پشتیبان معتبر «نمک‌پاش» نیست.";
        }

        StateHasChanged();
    }
}
