<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Splitt.App.Views.TripDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Splitt.App.ViewModels"
    x:DataType="vm:TripDetailViewModel"
    Title="{Binding TripName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="ویرایش" Command="{Binding EditTripCommand}" />
        <ToolbarItem Text="پشتیبان" Command="{Binding ExportCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="12">

        <!-- Segmented tabs -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                StrokeShape="RoundRectangle 14"
                Padding="4">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Text="هزینه‌ها"
                        Command="{Binding ShowExpensesCommand}"
                        FontFamily="VazirmatnSemiBold" FontSize="13"
                        CornerRadius="11" MinimumHeightRequest="40" Padding="0,8">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpensesTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsExpensesTab}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="تراز و تسویه"
                        Command="{Binding ShowBalancesCommand}"
                        FontFamily="VazirmatnSemiBold" FontSize="13"
                        CornerRadius="11" MinimumHeightRequest="40" Padding="0,8">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBalancesTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsBalancesTab}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="گزارش"
                        Command="{Binding ShowReportCommand}"
                        FontFamily="VazirmatnSemiBold" FontSize="13"
                        CornerRadius="11" MinimumHeightRequest="40" Padding="0,8">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsReportTab}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsReportTab}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Expenses tab ===== -->
        <Grid Grid.Row="1" IsVisible="{Binding IsExpensesTab}">
            <CollectionView ItemsSource="{Binding Expenses}"
                            IsVisible="{Binding HasExpenses}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <Grid Padding="4,0,4,10" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="مجموع هزینه‌ها:" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource CaptionLabel}"
                               FontFamily="VazirmatnSemiBold" Margin="6,0,0,0" VerticalOptions="Center" />
                    </Grid>
                </CollectionView.Header>
                <CollectionView.Footer>
                    <Grid HeightRequest="88" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExpenseRow">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenExpenseCommand, Source={RelativeSource AncestorType={x:Type vm:TripDetailViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSettlement}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CreditorSoft}, Dark={StaticResource CreditorSoftDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <Label Text="🤝" FontSize="13" IsVisible="{Binding IsSettlement}" VerticalOptions="Center" />
                                    <Label Text="{Binding Description}" FontFamily="VazirmatnMedium" FontSize="15" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Meta}" Style="{StaticResource CaptionLabel}" FontSize="12" />
                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Text="{Binding AmountText}"
                                       Style="{StaticResource AmountLabel}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding SharesText}"
                                       IsVisible="{Binding HasShares}"
                                       Style="{StaticResource CaptionLabel}"
                                       FontSize="11"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextHint}, Dark={StaticResource TextHintDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding HasExpenses, Converter={StaticResource Not}}"
                                 VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32,0">
                <Label Text="🧾" FontSize="56" HorizontalOptions="Center" />
                <Label Text="هنوز هزینه‌ای ثبت نشده" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
                <Label Text="اولین هزینه را اضافه کن تا حساب‌وکتاب شروع شود."
                       Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Button Text="＋ هزینهٔ جدید"
                    Style="{StaticResource Fab}"
                    Command="{Binding AddExpenseCommand}"
                    VerticalOptions="End"
                    Margin="0,0,0,8" />
        </Grid>

        <!-- ===== Balances tab ===== -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsBalancesTab}">
            <VerticalStackLayout Spacing="12">

                <!-- Balance rows -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14"
                                         BindableLayout.ItemsSource="{Binding Balances}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BalanceRow">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding Name}" FontFamily="VazirmatnMedium" VerticalOptions="Center" />
                                        <Label Text="{Binding StatusText}" FontSize="11" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCreditor}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Creditor}, Dark={StaticResource CreditorDark}}" />
                                                </DataTrigger>
                                                <MultiTrigger TargetType="Label">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsCreditor}" Value="False" />
                                                        <BindingCondition Binding="{Binding IsZero}" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Debtor}, Dark={StaticResource DebtorDark}}" />
                                                </MultiTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding AmountText}"
                                           Style="{StaticResource AmountLabel}"
                                           FontSize="15">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCreditor}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Creditor}, Dark={StaticResource CreditorDark}}" />
                                            </DataTrigger>
                                            <MultiTrigger TargetType="Label">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding IsCreditor}" Value="False" />
                                                    <BindingCondition Binding="{Binding IsZero}" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Debtor}, Dark={StaticResource DebtorDark}}" />
                                            </MultiTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsZero}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextHint}, Dark={StaticResource TextHintDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding Fraction}"
                                                 HeightRequest="6">
                                        <ProgressBar.Triggers>
                                            <DataTrigger TargetType="ProgressBar" Binding="{Binding IsCreditor}" Value="True">
                                                <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Creditor}, Dark={StaticResource CreditorDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="ProgressBar" Binding="{Binding IsCreditor}" Value="False">
                                                <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Debtor}, Dark={StaticResource DebtorDark}}" />
                                            </DataTrigger>
                                        </ProgressBar.Triggers>
                                    </ProgressBar>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Fully settled -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsSettled}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CreditorSoft}, Dark={StaticResource CreditorSoftDark}}">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="18" VerticalOptions="Center" />
                        <Label Text="همه تسویه‌اند — چیزی برای پرداخت نمانده."
                               FontFamily="VazirmatnMedium" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Settlement suggestions -->
                <Label Text="پیشنهاد تسویه" Style="{StaticResource SectionLabel}"
                       IsVisible="{Binding HasSuggestions}" Margin="4,8,4,0" />
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding HasSuggestions}"
                                     BindableLayout.ItemsSource="{Binding Suggestions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettlementRow">
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Text}" FontFamily="VazirmatnMedium" FontSize="14" />
                                        <Label Text="{Binding AmountText}" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="ثبت تسویه"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="13"
                                            MinimumHeightRequest="40"
                                            Padding="14,6"
                                            VerticalOptions="Center"
                                            Command="{Binding RecordSettlementCommand, Source={RelativeSource AncestorType={x:Type vm:TripDetailViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid HeightRequest="24" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Report tab ===== -->
        <Grid Grid.Row="1" IsVisible="{Binding IsReportTab}">
            <ScrollView IsVisible="{Binding HasExpenses}">
                <VerticalStackLayout Spacing="12">

                    <!-- Totals header -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="جمع هزینه‌ها" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalText}" FontFamily="VazirmatnSemiBold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="0" Text="میانگین هر نفر" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding AverageText}" FontFamily="VazirmatnSemiBold" FontSize="15" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Per-person expandable cards -->
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ReportRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonReportRow">
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding ToggleReportRowCommand, Source={RelativeSource AncestorType={x:Type vm:TripDetailViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="3">

                                        <!-- Collapsed summary row -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="3">
                                            <Label Grid.Row="0" Grid.Column="0" FontSize="11" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextHint}, Dark={StaticResource TextHintDark}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="▲" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                                        <Setter Property="Text" Value="▼" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontFamily="VazirmatnMedium" FontSize="15" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding NetAmountText}" Style="{StaticResource AmountLabel}" FontSize="15" HorizontalTextAlignment="End">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCreditor}" Value="True">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Creditor}, Dark={StaticResource CreditorDark}}" />
                                                        </DataTrigger>
                                                        <MultiTrigger TargetType="Label">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding IsCreditor}" Value="False" />
                                                                <BindingCondition Binding="{Binding IsZero}" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Debtor}, Dark={StaticResource DebtorDark}}" />
                                                        </MultiTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsZero}" Value="True">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextHint}, Dark={StaticResource TextHintDark}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding NetLabel}" FontSize="10" HorizontalTextAlignment="End"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource CaptionLabel}" FontSize="12" />
                                        </Grid>

                                        <!-- Expanded details -->
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExpanded}" Margin="0,8,0,0">

                                            <Label Text="پرداخت‌ها" FontFamily="VazirmatnSemiBold" FontSize="12"
                                                   IsVisible="{Binding HasPaidItems}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasPaidItems}"
                                                                 BindableLayout.ItemsSource="{Binding PaidItems}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReportItemRow">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                                <Label Text="{Binding Description}" FontSize="13" VerticalOptions="Center" />
                                                                <Label Text="{Binding DateText}" Style="{StaticResource CaptionLabel}" FontSize="11" VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                            <Label Grid.Column="1" Text="{Binding AmountText}" Style="{StaticResource AmountLabel}" FontSize="13" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Label Text="سهم‌ها" FontFamily="VazirmatnSemiBold" FontSize="12"
                                                   IsVisible="{Binding HasShareItems}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding HasShareItems}"
                                                                 BindableLayout.ItemsSource="{Binding ShareItems}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReportItemRow">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                                <Label Text="{Binding Description}" FontSize="13" VerticalOptions="Center" />
                                                                <Label Text="{Binding DateText}" Style="{StaticResource CaptionLabel}" FontSize="11" VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                            <Label Grid.Column="1" Text="{Binding AmountText}" Style="{StaticResource AmountLabel}" FontSize="13" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Label Text="{Binding SettledText}" IsVisible="{Binding HasSettled}"
                                                   Style="{StaticResource CaptionLabel}" FontSize="12" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid HeightRequest="88" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding HasExpenses, Converter={StaticResource Not}}"
                                 VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="32,0">
                <Label Text="📊" FontSize="56" HorizontalOptions="Center" />
                <Label Text="هنوز گزارشی وجود ندارد" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
                <Label Text="با ثبت اولین هزینه، گزارش سفر ساخته می‌شود."
                       Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Button Text="ارسال گزارش"
                    Style="{StaticResource Fab}"
                    IsVisible="{Binding HasExpenses}"
                    Command="{Binding ShareReportCommand}"
                    VerticalOptions="End"
                    Margin="0,0,0,8" />
        </Grid>
    </Grid>
</ContentPage>
