<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Splitt.App.Views.TripEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Splitt.App.ViewModels"
    x:DataType="vm:TripEditorViewModel"
    Title="{Binding PageTitle}">

    <Grid RowDefinitions="*,Auto" Padding="{StaticResource PagePadding}">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">

                <Label Text="نام رویداد" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource FieldCard}">
                    <Entry Text="{Binding Name}" Placeholder="مثلاً: سفر شمال" />
                </Border>

                <Label Text="شرکت‌کننده‌ها" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                <Border Style="{StaticResource FieldCard}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding NewParticipantName}"
                               Placeholder="نام (مثلاً: امیر)"
                               ReturnCommand="{Binding AddParticipantCommand}"
                               ReturnType="Done" />
                        <Button Grid.Column="1"
                                Text="افزودن"
                                Style="{StaticResource SecondaryButton}"
                                MinimumHeightRequest="40"
                                Padding="14,6"
                                VerticalOptions="Center"
                                Command="{Binding AddParticipantCommand}" />
                    </Grid>
                </Border>

                <FlexLayout BindableLayout.ItemsSource="{Binding Participants}"
                            Wrap="Wrap" Direction="Row" JustifyContent="Start"
                            AlignItems="Center" AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParticipantItem">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,8"
                                    Margin="0,0,8,8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}"
                                           FontFamily="VazirmatnMedium"
                                           TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}"
                                           VerticalOptions="Center" />
                                    <Label Text="✕"
                                           FontSize="13"
                                           IsVisible="{Binding CanRemove}"
                                           TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}"
                                           VerticalOptions="Center"
                                           Padding="4,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding RemoveParticipantCommand, Source={RelativeSource AncestorType={x:Type vm:TripEditorViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="کسانی که در هزینه‌ای سهیم بوده‌اند قابل حذف نیستند."
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding IsEditing}" />

                <Button Text="حذف رویداد"
                        Style="{StaticResource DangerTextButton}"
                        Command="{Binding DeleteTripCommand}"
                        IsVisible="{Binding IsEditing}"
                        Margin="0,16,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                Text="ذخیره"
                Command="{Binding SaveCommand}"
                Margin="0,12,0,0" />
    </Grid>
</ContentPage>
